# Postgres credentials used by docker-compose.yml.
POSTGRES_PASSWORD=postgres

# Keycloak admin password (only used when the Keycloak service is enabled).
KEYCLOAK_ADMIN_PASSWORD=admin

# Optional: override the default seeded admin password (matches Seed:Admin:Password).
ADMIN_PASSWORD=Admin123!

# Optional host paths mounted into the container.
# ARCAFS_FILES=./data/files
# ARCAFS_LOGS=./data/logs
# ARCAFS_THUMBS=./data/thumbnails
