<Project Sdk="Microsoft.NET.Sdk.Web">

	<!--
		ArcaFS.Desktop wraps the Blazor Server web app inside an Electron shell using
		ElectronNET.Core. The original ArcaFS web project is unchanged. To avoid
		duplicating code, this project shares the source from ..\ArcaFS\ via linked
		Compile / Content items rather than via a project reference. The Web SDK can't
		treat another Web SDK project as a library cleanly (only one Program.Main), so
		source linking gives us a separate entry point + assembly while reusing every
		Razor component, page, and static asset.
	-->

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<!--
		  LogVue's dashboard needs the framework's blazor.web.js. The Web SDK only restores that
		  file when this property is set on the host, and package props are not imported during
		  restore, so it has to be set here.
		-->
		<RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>ArcaFS</RootNamespace>
		<AssemblyName>ArcaFS.Desktop</AssemblyName>
		<UserSecretsId>arcafs-desktop-8c2e1a47-3f6b-4d91-9e0c-5b7a2d4f8c13</UserSecretsId>
		<RuntimeIdentifiers>win-x64;linux-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Ardalis.Result" />
		<PackageReference Include="Hangfire.AspNetCore" />
		<PackageReference Include="Heroicsoft.NetForge.Authentication" />
		<PackageReference Include="Heroicsoft.NetForge.Components" />
		<PackageReference Include="Heroicsoft.NetForge.Hangfire" />
		<PackageReference Include="Heroicsoft.NetForge.Results" />
		<PackageReference Include="LogVue" />
		<PackageReference Include="LogVue.Providers.Serilog" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
		<PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
		<PackageReference Include="Microsoft.AspNetCore.Identity.UI" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Serilog.AspNetCore" />
		<PackageReference Include="Serilog.Sinks.File" />

		<PackageReference Include="ElectronNET.Core" />
		<PackageReference Include="ElectronNET.Core.AspNet" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ArcaFS.Core\ArcaFS.Core.csproj" />
		<ProjectReference Include="..\ArcaFS.Data\ArcaFS.Data.csproj" />
		<ProjectReference Include="..\ArcaFS.Data.Sqlite\ArcaFS.Data.Sqlite.csproj" />
		<ProjectReference Include="..\ArcaFS.Data.Sql\ArcaFS.Data.Sql.csproj" />
		<ProjectReference Include="..\ArcaFS.Data.Npgsql\ArcaFS.Data.Npgsql.csproj" />
		<ProjectReference Include="..\ArcaFS.Data.MySql\ArcaFS.Data.MySql.csproj" />
		<ProjectReference Include="..\ArcaFS.Models\ArcaFS.Models.csproj" />
		<ProjectReference Include="..\ArcaFS.Services\ArcaFS.Services.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\ArcaFS\**\*.cs" Exclude="..\ArcaFS\Program.cs;..\ArcaFS\bin\**\*.cs;..\ArcaFS\obj\**\*.cs" LinkBase="Shared" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="..\ArcaFS\Components\**\*.razor" Link="Components\%(RecursiveDir)%(Filename)%(Extension)" />
		<Content Include="..\ArcaFS\Components\**\*.cshtml" Link="Components\%(RecursiveDir)%(Filename)%(Extension)" />
		<Content Include="..\ArcaFS\Areas\**\*.cshtml" Link="Areas\%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="..\ArcaFS\wwwroot\**\*" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>
	<ItemGroup>
		<Folder Include="wwwroot\" />
	</ItemGroup>
</Project>