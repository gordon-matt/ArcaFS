<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>ArcaFS</RootNamespace>
		<Version>1.0.0</Version>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Hangfire.Core" Version="1.8.23" />
		<PackageReference Include="Heroicsoft.NetForge.Abstractions" Version="1.0.1-beta" />
		<!-- Hangfire.Core pulls Newtonsoft.Json 11.0.1, which has advisory GHSA-5crp-9r3c-p9vr. -->
