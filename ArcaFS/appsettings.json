{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Hangfire": "Warning"
      }
    }
  },
  "LogVue": {
    "Title": "ArcaFS",
    // Deletes log entries older than this many days. 0 keeps everything.
    "RetentionDays": 30
  },
  "AllowedHosts": "*",

  "Database": {
    "Provider": "Sqlite"
  },

  "ConnectionStrings": {
    "DefaultConnection": "Data Source=arcafs.db",
    "Hangfire": ""
  },

  "Hangfire": {
    "SqlitePath": "hangfire.db"
  },

  "Authentication": {
    "Provider": "Identity",

    "Keycloak": {
      "Authority": "",
      "ClientId": "",
      "ClientSecret": "",
      "AdminClientId": "",
      "AdminClientSecret": "",
      "PublicOrigin": "",
      "BackchannelBaseUrl": ""
    }
  },

  "Seed": {
    "Admin": {
      "Email": "",
      "UserName": "",
      "Password": ""
    }
  },

  "Thumbnails": {
    "Enabled": true,
    "CacheDirectory": "",
    "Quality": 75,
    "CacheRetentionDays": 30
  },

  "Uploads": {
    "MaxRequestBodyMegabytes": 4096
  },

  "Hosting": {
    "DataRoot": "/app/data"
  },

  "Desktop": {
    "DefaultSourcePath": ""
  }
}
