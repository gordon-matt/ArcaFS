{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Hangfire": "Warning"
      }
    }
  },
  "LogVue": {
    "Title": "ArcaFS",
    // Deletes log entries older than this many days. 0 keeps everything.
    "RetentionDays": 30
  },
  "AllowedHosts": "*",

  "Database": {
    "Provider": "Sqlite"
  },

  "ConnectionStrings": {
    "DefaultConnection": "Data Source=arcafs.db",
    "Hangfire": ""
  },

  "Hangfire": {
    "SqlitePath": "hangfire.db"
  },

  "Authentication": {
    "Provider": "Identity",

    "Keycloak": {
      "Authority": "",
      "ClientId": "",
      "ClientSecret": "",
      "AdminClientId": "",
      "AdminClientSecret": "",
      "PublicOrigin": "",
      "BackchannelBaseUrl": ""
    }
  },

  "Seed": {
    "Admin": {
      "Email": "",
      "UserName": "",
      "Password": ""
    }
  },

  "Thumbnails": {
    "Enabled": true,
    "CacheDirectory": "",
    "Quality": 75,
    "CacheRetentionDays": 30,
    "Video": {
      "Enabled": true,
      // The official ffmpeg build is GPL. Leave this false and install ffmpeg yourself,
      // or set it true to download that build into an ffmpeg folder under the content root.
      "DownloadIfMissing": false
    }
  },

  "Uploads": {
    "MaxRequestBodyMegabytes": 4096,
    "ImageResize": {
      "Enabled": false,
      "MaxWidth": 2560,
      "MaxHeight": 2560
    }
  },

  "Hosting": {
    "DataRoot": "/app/data"
  },

  "Desktop": {
    "DefaultSourcePath": ""
  }
}
