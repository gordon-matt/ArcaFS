@*
    Custom layout for the embedded ASP.NET Identity UI (`AddDefaultUI()`).
    The default layout shipped with Microsoft.AspNetCore.Identity.UI references partials
    (`_LoginPartial`, `_ValidationScriptsPartial`) we never scaffolded into this Blazor Server
    project, so we replace it wholesale. Identity pages here intentionally do not host the
    Blazor sidebar — they are plain Razor Pages rendered before the Blazor circuit is up.
*@
@using ArcaFS.Services.Settings
@inject IServerSettingsService ServerSettings
@{
    var settings = await ServerSettings.GetAllAsync(Context.RequestAborted);
    string theme = settings.Theme;
    string siteName = settings.SiteName;
    string colorScheme = Constants.BootswatchThemes.IsDarkColorScheme(theme) ? "dark" : "light";
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="@colorScheme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @siteName</title>
    <link rel="stylesheet" href="~/lib/bootswatch/dist/@(theme)/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
</head>
<body class="bg-body-tertiary">
    <nav class="navbar navbar-expand-md bg-body border-bottom">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">
                <i class="bi bi-archive-fill text-primary"></i> @siteName
            </a>
        </div>
    </nav>

    <main class="container py-4">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="card shadow-sm">
                    <div class="card-body p-4">
                        @RenderBody()
                    </div>
                </div>
            </div>
        </div>
    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
