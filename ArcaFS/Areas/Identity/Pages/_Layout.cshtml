@using Microsoft.Extensions.Options
@using Heroicsoft.NetForge.Components
@inject IOptions<ForgeUiOptions> UiOptions
@inject IServerSettingsService ServerSettings
@*
    Identity pages render before a Blazor circuit exists, so they load the same stylesheet,
    theme script and accent as the app shell.
*@
@{
    var settings = await ServerSettings.GetAllAsync(Context.RequestAborted);
    var ui = UiOptions.Value;
    string? accentCss = ForgeAccentCss.Build(ui);
    string defaultScheme = settings.Theme is "light" or "dark" or "system"
        ? settings.Theme
        : ui.DefaultColorScheme;
}
<!DOCTYPE html>
<html lang="en" data-theme="@(defaultScheme == "dark" ? "dark" : "light")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @settings.SiteName</title>
    <link rel="icon" type="image/png" href="~/img/Icon.png" />
    <script src="~/_content/Heroicsoft.NetForge.Components/js/theme-init.js"
            data-theme-key="@ui.ThemeStorageKey"
            data-default-theme="@defaultScheme"></script>
    <link rel="stylesheet" href="~/_content/Heroicsoft.NetForge.Components/css/nf.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    @if (accentCss is not null)
    {
        <style>@Html.Raw(accentCss)</style>
    }
</head>
<body>
    <div class="nf-standalone">
        <div class="nf-standalone-body">
            <div class="nf-auth-card">
                <a class="nf-brand-link" href="/">
                    <img src="~/img/Icon.png" alt="" />
                    <span class="nf-brand-text">@settings.SiteName</span>
                </a>
                @RenderBody()
            </div>
        </div>
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
