@inject IFileSystemService FileSystemService

@* Shared body of the file viewer: dialog and full page both render this. *@
<div class="arca-preview-stage">
    @if (isLoadingText)
    {
        <div class="p-5 text-center w-100 bg-body">
            <div class="spinner-border text-primary" role="status"></div>
        </div>
    }
    else if (textError is not null)
    {
        <div class="p-5 text-center w-100 bg-body">
            <p class="mb-0 text-danger">@textError</p>
        </div>
    }
    else
    {
        @switch (Kind)
        {
            case FileKind.Image:
                <img class="arca-checkered" src="@DownloadUrl" alt="@Name" />
                break;

            case FileKind.Video:
                <video controls autoplay style="width: 100%;" @key="Path">
                    <source src="@DownloadUrl" />
                </video>
                break;

            case FileKind.Audio:
                <div class="p-5 text-center w-100 bg-body">
                    <i class="bi bi-file-earmark-music display-1 text-info"></i>
                    <audio controls autoplay class="w-100 mt-3" @key="Path">
                        <source src="@DownloadUrl" />
                    </audio>
                </div>
                break;

            case FileKind.Pdf:
                <iframe src="@DownloadUrl" title="@Name"
                        style="width: 100%; height: 78vh; border: 0;"></iframe>
                break;

            case FileKind.Text:
            case FileKind.Code:
                <pre class="arca-preview-text mb-0">@textContent</pre>
                break;

            default:
                <div class="p-5 text-center w-100 bg-body">
                    <FileIcon Kind="Kind" CssClass="display-1" />
                    <p class="mt-3 mb-0 text-body-secondary">
                        There's no preview for this file type.
                    </p>
                    <a class="btn btn-primary mt-3" href="@AttachmentUrl">
                        <i class="bi bi-download me-1"></i> Download
                    </a>
                </div>
                break;
        }
    }
</div>

@code {
    [Parameter]
    public int SourceId { get; set; }

    [Parameter]
    public string Path { get; set; } = Constants.RootPath;

    [Parameter]
    public string Name { get; set; } = string.Empty;

    [Parameter]
    public FileKind Kind { get; set; }

    private bool isLoadingText;
    private string? textContent;
    private string? textError;

    private string DownloadUrl =>
        $"/api/files/download?sourceId={SourceId}&path={Uri.EscapeDataString(Path)}&inline=true";

    private string AttachmentUrl =>
        $"/api/files/download?sourceId={SourceId}&path={Uri.EscapeDataString(Path)}";

    protected override async Task OnParametersSetAsync()
    {
        textContent = null;
        textError = null;

        if (!FileKinds.IsEditable(Kind))
        {
            return;
        }

        isLoadingText = true;
        var result = await FileSystemService.ReadTextAsync(SourceId, Path);
        isLoadingText = false;

        if (result.IsSuccess)
        {
            textContent = result.Value.Content;
        }
        else
        {
            textError = result.GetDisplayMessage();
        }
    }
}
