@inject IFileSystemService FileSystemService

@* Right-hand details panel. Directory sizes are loaded on demand rather than with the listing,
   because walking a large tree takes long enough to stall the first paint. *@
<aside class="arca-info" aria-label="Details">
    <div class="arca-info-header">
        <span>Details</span>
        <span class="arca-toolbar-spacer"></span>
        <button type="button" class="arca-icon-button" aria-label="Close details" @onclick="OnClose">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>

    @if (Detail is null)
    {
        <div class="arca-info-body text-body-secondary">Select an item to see its details.</div>
    }
    else
    {
        <div class="arca-info-body">
            <div class="arca-info-preview @(Detail.Kind is FileKind.Image or FileKind.Video && !thumbFailed ? "arca-checkered" : null)">
                @if (Detail.Kind is FileKind.Image or FileKind.Video && !thumbFailed)
                {
                    <img alt="" src="@($"/api/files/thumb?sourceId={Detail.SourceId}&path={Uri.EscapeDataString(Detail.Path)}&size=384&v={Detail.ModifiedAt.Ticks}")"
                         @onerror="() => thumbFailed = true" />
                }
                else
                {
                    <FileIcon Kind="Detail.Kind" CssClass="display-4" />
                }
            </div>

            <p class="arca-info-name" title="@Detail.Name">@Detail.Name</p>

            <dl class="arca-info-list">
                <dt>Type</dt>
                <dd class="text-break">@(Detail.IsDirectory ? "Folder" : Detail.MimeType)</dd>

                <dt>Size</dt>
                <dd>
                    @if (Detail.IsDirectory)
                    {
                        @if (directorySize is not null)
                        {
                            <span>@FormatBytes(directorySize.SizeBytes)</span>
                            <div class="text-body-secondary">
                                @directorySize.FileCount files, @directorySize.DirectoryCount folders
                            </div>
                        }
                        else if (isCalculating)
                        {
                            <span class="text-body-secondary">Calculating…</span>
                        }
                        else
                        {
                            <button type="button" class="btn btn-link btn-sm p-0" @onclick="CalculateSizeAsync">
                                Calculate
                            </button>
                        }
                    }
                    else
                    {
                        @FormatBytes(Detail.SizeBytes)
                    }
                </dd>

                @if (Detail is { ImageWidth: int width, ImageHeight: int height })
                {
                    <dt>Dimensions</dt>
                    <dd>@width × @height</dd>
                }

                <dt>Modified</dt>
                <dd>@Detail.ModifiedAt.ToLocalTime().ToString("g")</dd>

                <dt>Created</dt>
                <dd>@Detail.CreatedAt.ToLocalTime().ToString("g")</dd>

                <dt>Path</dt>
                <dd class="text-break font-monospace" style="font-size: 0.75rem;">@Detail.Path</dd>
            </dl>

            <div class="d-flex flex-wrap gap-1 mb-3">
                @foreach (string permission in Detail.Permissions.ToDisplayNames())
                {
                    <span class="arca-perm-chip arca-perm-allow">@permission</span>
                }
                @if (Detail.Permissions == FilePermission.None)
                {
                    <span class="arca-perm-chip arca-perm-deny">No access</span>
                }
            </div>

            <AuthorizeView Roles="@WellKnownRoles.Administrator">
                <a class="btn btn-sm btn-outline-secondary"
                   href="@($"/admin/access?sourceId={Detail.SourceId}&path={Uri.EscapeDataString(Detail.Path)}")">
                    <i class="bi bi-shield-lock me-1"></i> Access rules
                </a>
            </AuthorizeView>
        </div>
    }
</aside>

@code {
    [Parameter]
    public FileDetailDto? Detail { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private DirectorySizeDto? directorySize;
    private bool isCalculating;
    private bool thumbFailed;
    private string? lastLoadedPath;

    protected override void OnParametersSet()
    {
        // A stale size from the previously selected folder would be actively misleading.
        if (Detail?.Path != lastLoadedPath)
        {
            lastLoadedPath = Detail?.Path;
            directorySize = null;
            isCalculating = false;
            thumbFailed = false;
        }
    }

    private async Task CalculateSizeAsync()
    {
        if (Detail is null)
        {
            return;
        }

        isCalculating = true;

        var result = await FileSystemService.GetDirectorySizeAsync(Detail.SourceId, Detail.Path);

        directorySize = result.IsSuccess ? result.Value : null;
        isCalculating = false;
    }

    private static string FormatBytes(long bytes)
    {
        string[] units = ["B", "KB", "MB", "GB", "TB", "PB"];
        double size = bytes;
        int unit = 0;

        while (size >= 1024 && unit < units.Length - 1)
        {
            size /= 1024;
            unit++;
        }

        return unit == 0
            ? $"{bytes} B"
            : $"{size.ToString(size < 10 ? "0.0" : "0", CultureInfo.InvariantCulture)} {units[unit]}";
    }
}
