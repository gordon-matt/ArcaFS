@inject IJSRuntime JS

@* Full-screen viewer. Arrow keys move through the previewable items in the current folder, so a
   photo folder behaves like a gallery rather than needing a round trip per image. *@
@if (Current is not null)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true"
         @onkeydown="HandleKeyDown">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h2 class="modal-title fs-6 arca-truncate" title="@Current.Name">
                        <FileIcon Kind="Current.Kind" CssClass="me-1" />
                        @Current.Name
                    </h2>
                    <div class="ms-auto d-flex align-items-center gap-2">
                        @if (Items.Count > 1)
                        {
                            <span class="small text-body-secondary">
                                @(CurrentIndex + 1) / @Items.Count
                            </span>
                        }
                        <a class="btn btn-sm btn-outline-secondary" title="Download"
                           href="@DownloadUrl(inline: false)">
                            <i class="bi bi-download"></i>
                        </a>
                        <button type="button" class="btn-close" aria-label="Close"
                                @onclick="OnClose"></button>
                    </div>
                </div>

                <div class="modal-body p-0 position-relative">
                    @if (Items.Count > 1)
                    {
                        <button type="button" class="btn btn-dark rounded-circle arca-preview-nav prev"
                                aria-label="Previous" @onclick="() => Step(-1)">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        <button type="button" class="btn btn-dark rounded-circle arca-preview-nav next"
                                aria-label="Next" @onclick="() => Step(1)">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    }

                    <div class="arca-preview-stage">
                        @switch (Current.Kind)
                        {
                            case FileKind.Image:
                                <img src="@DownloadUrl(inline: true)" alt="@Current.Name" />
                                break;

                            case FileKind.Video:
                                @* @key forces a fresh element per file; reusing one leaves the
                                   previous video's buffered state and position behind. *@
                                <video controls autoplay style="width: 100%;" @key="Current.Path">
                                    <source src="@DownloadUrl(inline: true)" />
                                </video>
                                break;

                            case FileKind.Audio:
                                <div class="p-5 text-center w-100 bg-body">
                                    <i class="bi bi-file-earmark-music display-1 text-info"></i>
                                    <audio controls autoplay class="w-100 mt-3" @key="Current.Path">
                                        <source src="@DownloadUrl(inline: true)" />
                                    </audio>
                                </div>
                                break;

                            case FileKind.Pdf:
                                @* The browser's built-in viewer, rather than bundling pdf.js. *@
                                <iframe src="@DownloadUrl(inline: true)" title="@Current.Name"
                                        style="width: 100%; height: 78vh; border: 0;"></iframe>
                                break;

                            default:
                                <div class="p-5 text-center w-100 bg-body">
                                    <FileIcon Kind="Current.Kind" CssClass="display-1" />
                                    <p class="mt-3 mb-0 text-body-secondary">
                                        There's no preview for this file type.
                                    </p>
                                    <a class="btn btn-primary mt-3" href="@DownloadUrl(inline: false)">
                                        <i class="bi bi-download me-1"></i> Download
                                    </a>
                                </div>
                                break;
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    [Parameter, EditorRequired]
    public int SourceId { get; set; }

    /// <summary>The previewable items in the current folder, in display order.</summary>
    [Parameter]
    public IReadOnlyList<FileSystemItemDto> Items { get; set; } = [];

    [Parameter]
    public FileSystemItemDto? Current { get; set; }

    [Parameter]
    public EventCallback<FileSystemItemDto> OnNavigate { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private int CurrentIndex => Current is null
        ? -1
        : Items.ToList().FindIndex(i => i.Path == Current.Path);

    private string DownloadUrl(bool inline) =>
        $"/api/files/download?sourceId={SourceId}&path={Uri.EscapeDataString(Current!.Path)}" +
        $"&inline={inline.ToString().ToLowerInvariant()}";

    private async Task Step(int delta)
    {
        if (Items.Count == 0)
        {
            return;
        }

        // Wraps, so holding the arrow key through a folder doesn't dead-end at the last photo.
        int index = ((CurrentIndex + delta) % Items.Count + Items.Count) % Items.Count;

        await OnNavigate.InvokeAsync(Items[index]);
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        switch (args.Key)
        {
            case "ArrowLeft":
                await Step(-1);
                break;

            case "ArrowRight":
                await Step(1);
                break;

            case "Escape":
                await OnClose.InvokeAsync();
                break;
        }
    }
}
