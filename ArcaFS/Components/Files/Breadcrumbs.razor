@* Path trail. Anchors keep the app's breadcrumb classes so a drop highlight can land on them. *@
<Heroicsoft.NetForge.Components.Navigation.Breadcrumbs TItem="BreadcrumbDto"
                                                       Items="Items"
                                                       Class="arca-breadcrumb"
                                                       AriaLabel="Path"
                                                       Text="item => item.Name"
                                                       Href="item => BuildUrl(item.Path)"
                                                       OnNavigate="item => OnNavigate.InvokeAsync(item.Path)"
                                                       SeparatorClass="arca-breadcrumb-sep"
                                                       CurrentClass="arca-breadcrumb-current">
    <Leading Context="item">
        @if (item.Path == Constants.RootPath)
        {
            <i class="bi bi-hdd me-1"></i>
        }
    </Leading>
</Heroicsoft.NetForge.Components.Navigation.Breadcrumbs>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<BreadcrumbDto> Items { get; set; } = [];

    [Parameter, EditorRequired]
    public int SourceId { get; set; }

    [Parameter]
    public EventCallback<string> OnNavigate { get; set; }

    // Real hrefs even though navigation is intercepted, so middle-click and "copy link" work.
    private string BuildUrl(string path) =>
        $"/files/{SourceId}{(path == Constants.RootPath ? string.Empty : path)}";
}
