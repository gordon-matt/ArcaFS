@inherits LayoutComponentBase

@* Chrome-free layout for pages that stand alone: the first-run wizard and public share links,
   where a sidebar of sources the visitor can't reach would be noise at best. *@
<main class="arca-standalone">
    @Body
</main>

<Toaster />

<div id="blazor-error-ui" class="alert alert-danger m-0 rounded-0">
    <span>An unexpected error occurred.</span>
    <a href="" class="reload alert-link">Reload</a>
    <span class="dismiss float-end" role="button">&times;</span>
</div>
