@inherits LayoutComponentBase

<div class="arca-shell @(sidebarCollapsed ? "sidebar-collapsed" : null)">
    <Sidebar Collapsed="sidebarCollapsed" />

    <div class="arca-main">
        <Topbar OnToggleSidebar="ToggleSidebar" />

        <main class="arca-content">
            @Body
        </main>
    </div>
</div>

@* Rendered once at the shell level so any page can reach them. *@
<ThemePicker />
<Toaster />

<div id="blazor-error-ui" class="alert alert-danger m-0 rounded-0">
    <span>An unexpected error occurred.</span>
    <a href="" class="reload alert-link">Reload</a>
    <span class="dismiss float-end" role="button">&times;</span>
</div>

@code {
    private bool sidebarCollapsed;

    private void ToggleSidebar() => sidebarCollapsed = !sidebarCollapsed;
}
