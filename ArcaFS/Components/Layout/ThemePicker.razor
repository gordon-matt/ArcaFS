@implements IAsyncDisposable
@inject IJSRuntime JS

@* Per-browser theme in localStorage. The opener lives in the topbar as <ThemePickerOpener />. *@
<div class="modal fade" id="themePickerModal" tabindex="-1" aria-labelledby="themePickerModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="themePickerModalLabel">
                    <i class="bi bi-palette me-1"></i> Theme
                </h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="small text-body-secondary mb-2">
                    Saved in this browser only. Click to preview, then <strong>OK</strong> to keep it, or
                    <strong>Cancel</strong> to go back.
                </p>
                <ul class="nav nav-tabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button type="button" role="tab" aria-selected="@(showDarkTab ? "true" : "false")"
                                class="nav-link @(showDarkTab ? "active" : null)"
                                @onclick="() => showDarkTab = true">
                            Dark
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button type="button" role="tab" aria-selected="@(showDarkTab ? "false" : "true")"
                                class="nav-link @(showDarkTab ? null : "active")"
                                @onclick="() => showDarkTab = false">
                            Light
                        </button>
                    </li>
                </ul>

                <div class="tab-content pt-3">
                    <div class="list-group theme-picker-theme-list" role="tabpanel">
                        @foreach (string t in showDarkTab
                           ? Constants.BootswatchThemes.DarkThemes
                           : Constants.BootswatchThemes.LightThemes)
                        {
                            bool isPreview = string.Equals(t, previewTheme, StringComparison.OrdinalIgnoreCase);
                            bool isSaved = string.Equals(t, committedTheme, StringComparison.OrdinalIgnoreCase);
                            <button type="button"
                                    class="list-group-item list-group-item-action d-flex align-items-center justify-content-between gap-2 @(isPreview ? "active" : null)"
                                    @onclick="() => PreviewThemeAsync(t)">
                                <span>@TitleCase(t)</span>
                                @if (isSaved)
                                {
                                    <span class="badge rounded-pill ms-2">Saved</span>
                                }
                            </button>
                        }
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" @onclick="CancelAsync">Cancel</button>
                <button type="button" class="btn btn-primary" @onclick="OkAsync">OK</button>
            </div>
        </div>
    </div>
</div>

@code {
    private DotNetObjectReference<ThemePicker>? dotNetRef;

    /// <summary>Last theme written to localStorage.</summary>
    private string committedTheme = Constants.ServerSettingDefaults.Theme;

    /// <summary>Theme currently applied to the page, which differs while previewing.</summary>
    private string previewTheme = Constants.ServerSettingDefaults.Theme;

    private bool closedWithOk;

    private bool showDarkTab =
        Constants.BootswatchThemes.IsDarkColorScheme(Constants.ServerSettingDefaults.Theme);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        dotNetRef = DotNetObjectReference.Create(this);

        // Dismissing with Escape or the backdrop has to revert the preview, and Bootstrap only
        // reports that through its own event.
        await JS.InvokeVoidAsync("arcafs.registerThemeModalDismiss", "themePickerModal", dotNetRef);

        string raw = await JS.InvokeAsync<string>("arcafs.getStoredTheme");

        if (TryNormalizeTheme(raw, out string stored))
        {
            committedTheme = stored;
            previewTheme = stored;
            showDarkTab = Constants.BootswatchThemes.IsDarkColorScheme(stored);
        }

        StateHasChanged();
    }

    private async Task PreviewThemeAsync(string theme)
    {
        if (string.Equals(theme, previewTheme, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        await ApplyThemeToDomAsync(theme);
        StateHasChanged();
    }

    private async Task OkAsync()
    {
        await JS.InvokeVoidAsync("arcafs.setStoredTheme", previewTheme);
        committedTheme = previewTheme;
        closedWithOk = true;
        await JS.InvokeVoidAsync("arcafs.hideModal", "themePickerModal");
    }

    private async Task CancelAsync()
    {
        await ApplyThemeToDomAsync(committedTheme);
        await JS.InvokeVoidAsync("arcafs.hideModal", "themePickerModal");
    }

    private async Task ApplyThemeToDomAsync(string theme)
    {
        bool isDark = Constants.BootswatchThemes.IsDarkColorScheme(theme);

        await JS.InvokeVoidAsync(
            "arcafs.setThemeHref",
            $"lib/bootswatch/dist/{theme}/bootstrap.min.css",
            isDark ? "dark" : "light");

        previewTheme = theme;
        showDarkTab = isDark;
    }

    [JSInvokable]
    public async Task OnThemeModalDismissed()
    {
        if (closedWithOk)
        {
            closedWithOk = false;
            return;
        }

        if (!string.Equals(previewTheme, committedTheme, StringComparison.OrdinalIgnoreCase))
        {
            await ApplyThemeToDomAsync(committedTheme);
            await InvokeAsync(StateHasChanged);
        }
    }

    public ValueTask DisposeAsync()
    {
        dotNetRef?.Dispose();
        dotNetRef = null;

        return ValueTask.CompletedTask;
    }

    private static bool TryNormalizeTheme(string? raw, out string normalized)
    {
        normalized = Constants.ServerSettingDefaults.Theme;

        if (string.IsNullOrWhiteSpace(raw))
        {
            return false;
        }

        string theme = raw.Trim().ToLowerInvariant();

        if (!Constants.BootswatchThemes.All.Contains(theme, StringComparer.Ordinal))
        {
            return false;
        }

        normalized = theme;

        return true;
    }

    private static string TitleCase(string value) =>
        string.IsNullOrEmpty(value) ? value : char.ToUpperInvariant(value[0]) + value[1..];
}
