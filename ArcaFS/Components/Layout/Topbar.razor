@inject IAuthProviderService AuthProviderService
@inject NavigationManager Navigation

<header class="arca-topbar">
    <button type="button" class="btn btn-sm btn-link arca-sidebar-toggle" title="Toggle sidebar"
            @onclick="OnToggleSidebar">
        <i class="bi bi-list fs-4"></i>
    </button>

    <form class="arca-topbar-search" @onsubmit="SubmitSearch">
        <div class="input-group input-group-sm">
            <span class="input-group-text bg-body-tertiary border-end-0">
                <i class="bi bi-search"></i>
            </span>
            <input type="search" class="form-control border-start-0" placeholder="Search files…"
                   aria-label="Search files" @bind="searchTerm" @bind:event="oninput" />
        </div>
    </form>

    <div class="ms-auto d-flex align-items-center gap-1">
        <ThemePickerOpener />

        <AuthorizeView>
            <Authorized>
                <div class="dropdown">
                    <button class="btn btn-sm btn-link dropdown-toggle text-body" type="button"
                            data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-person-circle fs-5"></i>
                        <span class="d-none d-md-inline ms-1">@context.User.Identity?.Name</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <a class="dropdown-item" href="/profile">
                                <i class="bi bi-person me-2"></i> Profile
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="/shares">
                                <i class="bi bi-link-45deg me-2"></i> My shares
                            </a>
                        </li>
                        @if (AuthProviderService.Provider != AuthProvider.None)
                        {
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                @* A POST, so a stray link prefetch can't sign the user out. *@
                                <form action="@LogoutUrl" method="post">
                                    <AntiforgeryToken />
                                    <button type="submit" class="dropdown-item">
                                        <i class="bi bi-box-arrow-right me-2"></i> Sign out
                                    </button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            </Authorized>
            <NotAuthorized>
                <a class="btn btn-sm btn-primary" href="/">Sign in</a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</header>

@code {
    [Parameter]
    public EventCallback OnToggleSidebar { get; set; }

    private string searchTerm = string.Empty;

    private string LogoutUrl => AuthProviderService.Provider == AuthProvider.Keycloak
        ? "/auth/logout"
        : "/Identity/Account/Logout";

    private void SubmitSearch()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            return;
        }

        Navigation.NavigateTo($"/search?q={Uri.EscapeDataString(searchTerm)}");
    }
}
