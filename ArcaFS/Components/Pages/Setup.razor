@page "/setup"
@layout EmptyLayout
@attribute [AllowAnonymous]

@inject ISetupService SetupService
@inject NavigationManager Navigation

<PageTitle>Set up ArcaFS</PageTitle>

@* Deliberately outside the app shell: there is nothing to browse yet, and the sidebar would
   show empty sections that look broken. *@
<div class="container py-5" style="max-width: 42rem;">
    <div class="text-center mb-4 arca-setup-brand">
        <img class="arca-brand-logo" src="img/Logo.png" alt="ArcaFS" />
        <img class="arca-brand-mark" src="img/Icon.png" alt="" />
        <span class="arca-brand-name">ArcaFS</span>
        <h1 class="h3 mt-2">Welcome to ArcaFS</h1>
        <p class="text-body-secondary">A few questions and you're done.</p>
    </div>

    @if (state is null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
        </div>
    }
    else if (state.IsComplete)
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle me-2"></i>
            Setup is already finished.
            <a href="/" class="alert-link">Go to your files</a>.
        </div>
    }
    else
    {
        <ol class="list-group list-group-numbered mb-4">
            <li class="list-group-item d-flex align-items-center">
                <span class="ms-2 flex-grow-1">Administrator account</span>
                @if (state.HasAdministrator)
                {
                    <i class="bi bi-check-circle-fill text-success"></i>
                }
            </li>
            <li class="list-group-item d-flex align-items-center">
                <span class="ms-2 flex-grow-1">First source</span>
                @if (state.HasSource)
                {
                    <i class="bi bi-check-circle-fill text-success"></i>
                }
            </li>
        </ol>

        @if (errorMessage is not null)
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-octagon me-2"></i>@errorMessage
            </div>
        }

        @if (!state.HasAdministrator)
        {
            <div class="card mb-3">
                <div class="card-header">Create the administrator</div>
                <div class="card-body">
                    <EditForm Model="adminModel" OnValidSubmit="CreateAdministratorAsync">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <Field Label="Username" LabelClass="form-label" For="setupUserName">
<InputText id="setupUserName" class="form-control"
                                       @bind-Value="adminModel.UserName" autocomplete="username" />
</Field>
                            <ValidationMessage For="() => adminModel.UserName" class="text-danger small" />
                        </div>

                        <div class="mb-3">
                            <Field Label="Email" LabelClass="form-label" For="setupEmail">
<InputText id="setupEmail" type="email" class="form-control"
                                       @bind-Value="adminModel.Email" autocomplete="email" />
</Field>
                            <ValidationMessage For="() => adminModel.Email" class="text-danger small" />
                        </div>

                        <div class="mb-3">
                            <Field Label="Password" LabelClass="form-label" For="setupPassword">
<InputText id="setupPassword" type="password" class="form-control"
                                       @bind-Value="adminModel.Password" autocomplete="new-password" />
</Field>
                            <ValidationMessage For="() => adminModel.Password" class="text-danger small" />
                        </div>

                        <div class="mb-3">
                            <Field Label="Confirm password" LabelClass="form-label" For="setupConfirm">
<InputText id="setupConfirm" type="password" class="form-control"
                                       @bind-Value="adminModel.ConfirmPassword"
                                       autocomplete="new-password" />
</Field>
                            <ValidationMessage For="() => adminModel.ConfirmPassword"
                                               class="text-danger small" />
                        </div>

                        <button type="submit" class="btn btn-primary" disabled="@isBusy">
                            @if (isBusy)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            Create account
                        </button>
                    </EditForm>
                </div>
            </div>
        }
        else if (!state.HasSource)
        {
            <div class="card mb-3">
                <div class="card-header">Add your first source</div>
                <div class="card-body">
                    <EditForm Model="sourceModel" OnValidSubmit="CreateSourceAsync"
                              OnInvalidSubmit="OnSourceInvalid">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger small" />

                        <div class="mb-3">
                            <Field Label="Name" LabelClass="form-label" For="setupSourceName">
<InputText id="setupSourceName" class="form-control"
                                       @bind-Value="sourceModel.Name" />
</Field>
                            <ValidationMessage For="() => sourceModel.Name" class="text-danger small" />
                            <div class="form-text">What users will see in the sidebar.</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="setupSourcePath">Folder on this server</label>
                            <HostFolderPicker @bind-Path="sourceModel.Path"
                                              PathCommitted="OnFolderChosen">
                                <InputText id="setupSourcePath" class="form-control font-monospace"
                                           @bind-Value="sourceModel.Path" />
                            </HostFolderPicker>
                            <ValidationMessage For="() => sourceModel.Path" class="text-danger small" />
                        </div>

                        <div class="form-check mb-2">
                            <InputCheckbox id="setupPerUser" class="form-check-input"
                                           @bind-Value="sourceModel.UsePerUserDirectories" />
                            <label class="form-check-label" for="setupPerUser">
                                Give each user their own folder
                            </label>
                            <div class="form-text">
                                @* This is the scope template plus an Owner rule; explaining it
                                   here saves the admin a trip to the access-rules page. *@
                                Each user sees only a folder named after them, with full control
                                of it and no visibility into anyone else's.
                            </div>
                        </div>

                        <div class="form-check mb-3">
                            <InputCheckbox id="setupReadOnly" class="form-check-input"
                                           @bind-Value="sourceModel.IsReadOnly" />
                            <label class="form-check-label" for="setupReadOnly">
                                Read-only
                            </label>
                        </div>

                        <button type="submit" class="btn btn-primary" disabled="@isBusy">
                            @if (isBusy)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            Add source
                        </button>
                    </EditForm>
                </div>
            </div>
        }
        else
        {
            <div class="card">
                <div class="card-body text-center">
                    <i class="bi bi-check-circle display-5 text-success"></i>
                    <h2 class="h5 mt-2">All set</h2>
                    <p class="text-body-secondary">
                        You can add more sources and configure access rules from the
                        administration pages.
                    </p>
                    <button type="button" class="btn btn-primary" disabled="@isBusy"
                            @onclick="CompleteAsync">
                        Start using ArcaFS
                    </button>
                </div>
            </div>
        }

        <p class="small text-body-secondary text-center mt-4">
            Authentication: @state.AuthProviderName · Database: @state.DatabaseProviderName
        </p>
    }
</div>

@code {
    private SetupStateDto? state;
    private bool isBusy;
    private string? errorMessage;

    private readonly AdminModel adminModel = new();
    private readonly SourceModel sourceModel = new();

    protected override async Task OnInitializedAsync() => await RefreshStateAsync();

    private async Task RefreshStateAsync()
    {
        state = await SetupService.GetStateAsync();
    }

    private async Task CreateAdministratorAsync()
    {
        isBusy = true;
        errorMessage = null;

        try
        {
            var result = await SetupService.CreateAdministratorAsync(new SetupAdminRequest
            {
                UserName = adminModel.UserName,
                Email = adminModel.Email,
                Password = adminModel.Password,
            });

            if (!result.IsSuccess)
            {
                errorMessage = Describe(result, "The account could not be created.");
                return;
            }

            // A full reload, so the new sign-in cookie and the authentication state are picked up
            // rather than the circuit continuing as an anonymous visitor.
            Navigation.NavigateTo("/setup", forceLoad: true);
        }
        finally
        {
            isBusy = false;
        }
    }

    private void OnSourceInvalid()
    {
        errorMessage = "Enter a name and a folder that exists on this machine.";
    }

    private async Task CreateSourceAsync()
    {
        isBusy = true;
        errorMessage = null;

        try
        {
            var result = await SetupService.CreateFirstSourceAsync(new SetupSourceRequest
            {
                Name = sourceModel.Name,
                Path = sourceModel.Path,
                UsePerUserDirectories = sourceModel.UsePerUserDirectories,
                IsReadOnly = sourceModel.IsReadOnly,
            });

            if (!result.IsSuccess)
            {
                errorMessage = Describe(result, "The source could not be created.");
                return;
            }

            await RefreshStateAsync();
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task CompleteAsync()
    {
        isBusy = true;

        var result = await SetupService.CompleteAsync();

        isBusy = false;

        if (!result.IsSuccess)
        {
            errorMessage = Describe(result, "Setup could not be completed.");
            return;
        }

        Navigation.NavigateTo("/", forceLoad: true);
    }

    private void OnFolderChosen()
    {
        if (string.IsNullOrWhiteSpace(sourceModel.Name)
            && !string.IsNullOrWhiteSpace(sourceModel.Path))
        {
            // A sensible default beats an empty required field; the admin can still change it.
            sourceModel.Name = new DirectoryInfo(sourceModel.Path).Name is { Length: > 0 } name
                ? name
                : "Files";
        }
    }

    private static string Describe(Ardalis.Result.IResult result, string fallback) =>
        result.Status switch
        {
            ResultStatus.Invalid => string.Join(
                " ", result.ValidationErrors.Select(e => e.ErrorMessage)),
            ResultStatus.Forbidden => "Setup has already been completed.",
            _ => result.Errors.FirstOrDefault() ?? fallback,
        };

    private sealed class AdminModel
    {
        [Required(ErrorMessage = "Enter a username.")]
        [StringLength(64, MinimumLength = 2)]
        public string UserName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Enter an email address.")]
        [EmailAddress(ErrorMessage = "That doesn't look like an email address.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Enter a password.")]
        [StringLength(128, MinimumLength = 6,
            ErrorMessage = "Use at least 6 characters.")]
        public string Password { get; set; } = string.Empty;

        [Compare(nameof(Password), ErrorMessage = "The passwords don't match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }

    private sealed class SourceModel
    {
        [Required(ErrorMessage = "Enter a name.")]
        [StringLength(128)]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessage = "Choose a folder.")]
        public string Path { get; set; } = string.Empty;

        public bool UsePerUserDirectories { get; set; }

        public bool IsReadOnly { get; set; }
    }
}
