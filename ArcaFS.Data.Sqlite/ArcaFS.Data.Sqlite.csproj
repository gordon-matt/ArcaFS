<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Hangfire.Core" />
		<PackageReference Include="Hangfire.NetCore" />
		<PackageReference Include="Hangfire.Storage.SQLite" />
		<PackageReference Include="LogVue.Data.Sqlite" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
		<!--
		  Hangfire.Storage.SQLite depends on SQLitePCLRaw.bundle_green 2.1.11, which drags in
		  SQLitePCLRaw.lib.e_sqlite3 2.1.11 and advisory GHSA-2m69-gcr7-jv3q. bundle_green has no
		  patched release, so the native library carrying the vulnerability is pinned directly;
		  the bundle is only a meta-package over it.
		-->
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
		<PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ArcaFS.Data\ArcaFS.Data.csproj" />
	</ItemGroup>

</Project>
